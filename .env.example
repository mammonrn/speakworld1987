# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง (ห้าม commit ไฟล์ .env)

# Token ของบอท ขอจาก @BotFather บน Telegram
TELEGRAM_BOT_TOKEN=

# API key ของ Google Cloud ใช้กับสองบริการในโปรเจกต์เดียวกัน
# - Speech-to-Text: ถอดเสียงเป็นข้อความ
# - Translation v2: แปลคาซัค/พม่า และตรวจภาษาของข้อความพิมพ์
GOOGLE_API_KEY=

# API key ของ OpenAI ใช้แปลภาษาจีนและอังกฤษ (chat completion) ไม่ได้ใช้ถอดเสียงแล้ว
OPENAI_API_KEY=
