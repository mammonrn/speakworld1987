# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง (ห้าม commit ไฟล์ .env)

# Token ของบอท ขอจาก @BotFather บน Telegram
TELEGRAM_BOT_TOKEN=

# Telegram ID (ตัวเลข) ของผู้ดูแลระบบ — คนเดียวที่อนุมัติผู้ใช้และดูค่าใช้จ่ายได้
# หาได้จากการทักบอทอย่าง @userinfobot ถ้าไม่ตั้งค่า บอทจะไม่ตอบใครเลย
SUPER_ADMIN_ID=

# API key ของ Google Cloud ใช้กับสองบริการในโปรเจกต์เดียวกัน
# - Speech-to-Text: ถอดเสียงเป็นข้อความ
# - Translation v2: แปลคาซัค/พม่า/เวียดนาม และตรวจภาษาของข้อความพิมพ์
GOOGLE_API_KEY=

# API key ของ OpenAI ใช้แปลภาษาจีนและอังกฤษ (chat completion) ไม่ได้ใช้ถอดเสียงแล้ว
OPENAI_API_KEY=

# ที่เก็บไฟล์ข้อมูลระหว่างรัน (ภาษาที่เลือก, รายชื่อผู้ใช้, ปริมาณการใช้งาน)
# ไม่ตั้งก็ได้ ค่าเริ่มต้นคือโฟลเดอร์ data/ ข้างๆ ตัวโปรเจกต์
# DATA_DIR=
